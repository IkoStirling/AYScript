// Logia script for the PlayerController ScriptComponent (S2.5 model).
//
// This file references fields (`speed`, `jump_force`, `position`) that
// must be declared on the C++ side via AY_PROPERTY:
//   class PlayerController : public ScriptComponent {
//       AY_PROPERTY(float, speed, kAttrSerialize)
//       AY_PROPERTY(float, jump_force, kAttrSerialize)
//       AY_PROPERTY(math::FVector3, position, ...)
//   };
//   AY_FINALIZE_REGISTRATION_METADATA(PlayerController)
//
// Logia `var` is for script-internal Lua state only (pure local); C++
// fields are declared on the C++ side and accessed through `self`.
//
// S3.11: `self.position.{x,y}` (struct chain) compiles down to
// `ayt_reflect_get_field_chain(self, "PlayerController", "position",
// "y")` etc., and the assignments to
// `ayt_reflect_set_field_chain(...)`. The C++ side's
// `PlayerController::position.{x,y}` actually mutates at runtime —
// no more "runtime no-op" caveat.
//
// M1 (2026-07-15): `input.vec2("move")` returns a fresh Lua table
// {x=, y=} on each call, delegating to DeviceInputProvider ->
// InputMapping::getAxis2D(name). The convention is that the
// C++ side has pre-bound `bindAxis2D("move", "move_x", "move_y")`
// and the underlying 1-D axes via bindAxis(KeyPair{...}). The
// `var move: FVector2` annotation is purely Logia-side — analyzer
// treats it as a builtin (resolvedType=nullptr), so no C++
// object is allocated; `var` is still a Lua local.

script PlayerController {
    var tick_counter: int = 0

    on_start() {
        tick_counter = 0
    }

    on_update(dt: float) {
        tick_counter = tick_counter + 1
        if input.is_pressed("jump") {
            self.position.y = self.position.y + self.jump_force * dt
        }
        var move: FVector2 = input.vec2("move")
        if vec2.length(move) > 0.1 {
            // Vec2 helpers mutate the input table in place to save
            // an allocation; for one-shot per-frame use this is fine.
            // (Future slice can flip to fresh-table semantics.)
            self.apply_move(vec2.normalized(move), dt)
        }
    }

    on_destroy() {
        log.info("PlayerController destroyed")
    }
}