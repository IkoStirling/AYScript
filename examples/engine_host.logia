script EngineHost {
    state voice: int = 0
    on_start() {
        if ui.available() { ui.set_text("hud/hp", "Ready") }
        if audio.available() { voice = audio.play("audio/start.ayaudio", 0.5, false) }
        if animation.available() { animation.play(entity.self(), "animations/idle.ayanm", true) }
        if physics.available() {
            var hit: int = physics.raycast(vec3.new(0, 1, 0), vec3.new(0, -1, 0), 10.0, 4294967295)
            if hit != 0 {
                log.info("Ray hit")
                physics.release_hit(hit)
            }
        }
    }
    on_destroy() { audio.stop(voice) }
}
